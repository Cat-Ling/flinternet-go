# HTTP listen address (fallback: PORT)
FLINTERNET_ADDR=:8080

# Upstream Pinterest web host
FLINTERNET_BASE_URL=https://www.pinterest.com

# Upstream request timeout
FLINTERNET_TIMEOUT=20s

# In-memory response cache TTL
FLINTERNET_CACHE_TTL=5m

# Optional X-App-Version header override
FLINTERNET_APP_VERSION=

# Allow best-effort cursor continuation for search/feeds
FLINTERNET_ALLOW_UNVERIFIED_PAGINATION=true

# Log level: debug, info, warn, error
FLINTERNET_LOG_LEVEL=info
